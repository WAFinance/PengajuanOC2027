rules_version = '2';

// Aturan keamanan Firestore - Aplikasi Pengajuan Tenaga Alih Daya (BPBJ Kota Surakarta)
// Prinsip: semua hak akses ditentukan DI SINI (server), bukan oleh JavaScript di browser.
//   Admin  : memverifikasi Tahap 1, kelola akun, melihat semua pengajuan
//   Pokja  : memverifikasi Tahap 2 hanya untuk paket yang didelegasikan kepadanya
//   OPD    : hanya melihat/mengubah pengajuan milik satker sendiri
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- fungsi bantu
    function signedIn() { return request.auth != null; }
    function prof()     { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function aktif()    { return signedIn() && prof().status == 'Aktif'; }
    function isAdmin()  { return aktif() && (prof().role == 'Admin' || prof().role == 'Tim Konsolidasi'); }
    function isPokja()  { return aktif() && prof().role == 'Pokja'; }
    function isOpd()    { return aktif() && prof().role == 'OPD'; }

    // Siapa yang boleh melihat sebuah pengajuan (p = data pengajuan)
    function bolehLihat(p) {
      return isAdmin()
          || (isOpd()   && p.opd_pengaju == prof().satker)
          || (isPokja() && p.pokja_ditugaskan == prof().username);
    }

    // Referensi dokumen: berkas Drive atau tautan http(s) saja (mencegah javascript:/data:)
    function refDokOk(v) {
      return v is string
          && v.matches('^(gdrive:[A-Za-z0-9_-]{10,100}[|][A-Za-z0-9._-]{1,200}|link:https?://[^ <>"|]{4}[^ <>"|]*[|]Tautan Dokumen)$');
    }
    function linkOk(v) {
      return v is string && v.matches('^https?://[^ <>"|]{4}[^ <>"|]*$');
    }

    // ---------------------------------------------------------------- referensi (data publik)
    match /referensi_satker/{id}        { allow read: if true; allow write: if isAdmin(); }
    match /referensi_jenis_tenaga/{id}  { allow read: if true; allow write: if isAdmin(); }
    match /referensi_penyedia/{id}      { allow read: if true; allow write: if isAdmin(); }

    // ---------------------------------------------------------------- pencarian username saat login
    // Dibaca per-ID saja (tidak bisa didaftar), hanya berisi username -> email.
    match /login_lookup/{nama} {
      allow get: if true;
      allow list: if false;
      allow create: if (signedIn()
                        && request.resource.data.keys().hasOnly(['email', 'username_lower'])
                        && request.resource.data.username_lower == nama
                        && nama == nama.lower()
                        && request.resource.data.email == request.auth.token.email)
                    || isAdmin();
      allow update, delete: if isAdmin();
    }

    // ---------------------------------------------------------------- akun pengguna
    match /users/{uid} {
      // Pengguna membaca profilnya sendiri; Admin membaca semua
      allow get: if isAdmin()
                 || (signedIn() && (request.auth.uid == uid || resource.data.email == request.auth.token.email));
      allow list: if isAdmin()
                  || (signedIn() && resource.data.email == request.auth.token.email);

      // Pendaftaran mandiri HANYA boleh sebagai OPD berstatus Menunggu (tidak bisa menjadikan diri Admin/Aktif)
      allow create: if (signedIn() && request.auth.uid == uid
                        && request.resource.data.keys().hasOnly(['username', 'username_lower', 'email', 'satker', 'role', 'status', 'created_at'])
                        && request.resource.data.role == 'OPD'
                        && request.resource.data.status == 'Menunggu'
                        && request.resource.data.email == request.auth.token.email
                        && request.resource.data.username is string
                        && request.resource.data.username_lower == request.resource.data.username.lower()
                        && request.resource.data.created_at == request.time)
                    || isAdmin();
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ---------------------------------------------------------------- pengajuan
    match /pengajuan/{id} {

      // Mengubah pengajuan oleh OPD pemilik
      function opdUbah() {
        let lama = resource.data;
        let baru = request.resource.data;
        let diff = baru.diff(lama).affectedKeys();
        return isOpd()
            && lama.opd_pengaju == prof().satker
            && baru.opd_pengaju == lama.opd_pengaju
            && (!('dokumen_kak' in diff) || refDokOk(baru.dokumen_kak))
            && (!('dokumen_hps' in diff) || refDokOk(baru.dokumen_hps))
            && (!('link_katalog' in diff) || baru.link_katalog == null || linkOk(baru.link_katalog))
            && (
                 // (a) melengkapi/mengganti berkas selama belum final
                 ( baru.status == lama.status
                   && lama.status in ['Pending', 'Menunggu Verifikasi Tahap 1', 'Revisi', 'Revisi Dokumen']
                   && diff.hasOnly(['dokumen_kak', 'dokumen_hps']) )
                 ||
                 // (b) mengirim ulang setelah revisi / penggantian penyedia
                 ( lama.status in ['Revisi', 'Revisi Dokumen', 'Penyedia Ditolak']
                   && baru.status == 'Menunggu Verifikasi Tahap 1'
                   && (!('tahap' in diff) || baru.tahap == 1)
                   && diff.hasOnly(['dokumen_kak', 'dokumen_hps', 'nama_paket', 'calon_penyedia', 'nilai_hps',
                                    'jenis_tenaga_alih_daya', 'jumlah_tenaga', 'link_katalog', 'kode_rup',
                                    'pagu_anggaran', 'status', 'tahap', 'catatan_umum', 'catatan_item', 'riwayat_penyedia']) )
               );
      }

      // Verifikasi Tahap 2 oleh Pokja yang ditugaskan
      function pokjaUbah() {
        let lama = resource.data;
        let baru = request.resource.data;
        return isPokja()
            && lama.pokja_ditugaskan == prof().username
            && lama.status in ['Menunggu Verifikasi Tahap 2', 'Revisi Dokumen', 'Lolos Tahap 1']
            && baru.status in ['Disetujui', 'Revisi Dokumen', 'Ditolak']
            && baru.verifikator_tahap2 == prof().username
            && baru.diff(lama).affectedKeys().hasOnly(['status', 'catatan_umum', 'catatan_item', 'tahap',
                                                       'verifikator_tahap2', 'tgl_verifikasi_tahap2']);
      }

      allow get:  if aktif() && (resource == null || bolehLihat(resource.data));
      allow list: if bolehLihat(resource.data);

      allow create: if isOpd()
          && request.resource.data.keys().hasOnly(['dokumen_kak', 'dokumen_hps', 'opd_pengaju', 'nama_paket', 'calon_penyedia',
                                                   'nilai_hps', 'jenis_tenaga_alih_daya', 'jumlah_tenaga', 'link_katalog',
                                                   'kode_rup', 'pagu_anggaran', 'status', 'tahap', 'created_at'])
          && request.resource.data.keys().hasAll(['dokumen_kak', 'dokumen_hps', 'opd_pengaju', 'nama_paket', 'calon_penyedia',
                                                  'nilai_hps', 'jenis_tenaga_alih_daya', 'jumlah_tenaga', 'status', 'tahap', 'created_at'])
          && id.matches('^PGJ-[A-Z0-9]{1,30}-[0-9]{8}-[0-9]{1,6}$')
          && request.resource.data.opd_pengaju == prof().satker
          && request.resource.data.status == 'Menunggu Verifikasi Tahap 1'
          && request.resource.data.tahap == 1
          && request.resource.data.created_at == request.time
          && refDokOk(request.resource.data.dokumen_kak)
          && refDokOk(request.resource.data.dokumen_hps)
          && request.resource.data.nama_paket is string && request.resource.data.nama_paket.size() <= 200
          && request.resource.data.nilai_hps is number && request.resource.data.nilai_hps > 0
          && request.resource.data.jumlah_tenaga is number && request.resource.data.jumlah_tenaga > 0
          && (request.resource.data.link_katalog == null || linkOk(request.resource.data.link_katalog));

      allow update: if isAdmin() || pokjaUbah() || opdUbah();
      allow delete: if false;

      // ------------------------------------------------------------ klarifikasi / chat
      match /klarifikasi/{mid} {
        function induk() { return get(/databases/$(database)/documents/pengajuan/$(id)).data; }

        allow read: if bolehLihat(induk());
        allow create: if bolehLihat(induk())
            && request.resource.data.keys().hasOnly(['pengirim', 'role', 'pesan', 'created_at'])
            && request.resource.data.pengirim == prof().username
            && request.resource.data.role == prof().role
            && request.resource.data.pesan is string
            && request.resource.data.pesan.size() <= 10000
            && request.resource.data.created_at == request.time;
        allow update, delete: if false;
      }
    }

    // ---------------------------------------------------------------- selain itu: tertutup
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
